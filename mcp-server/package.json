{
  "name": "sherpa-mcp",
  "version": "0.1.1",
  "description": "MCP server that delegates high-volume file exploration, search, and transformation to a local LLM backend",
  "author": "Gastón Parravicini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tongas/sherpa-mcp.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/Tongas/sherpa-mcp#readme",
  "bugs": {
    "url": "https://github.com/Tongas/sherpa-mcp/issues"
  },
  "type": "module",
  "bin": {
    "sherpa-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "cp ../README.md ./README.md && npm run build",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "diff": "^5.2.0",
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.14.0",
    "@types/diff": "^5.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
